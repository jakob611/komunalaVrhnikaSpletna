{
  "name": "komunala-vrhnika-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/local.mjs\" \"vite --host 127.0.0.1\"",
    "dev:api": "node --watch server/local.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "node scripts/build-email.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test server/*.test.mjs",
    "test:api": "node --test server/*.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "cf:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/leaflet": "^1.9.20",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "react-email": "^6.11.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "wrangler": "latest"
  }
}
